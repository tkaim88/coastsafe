# Copy this file to .env and fill in real values. Never commit .env itself.

# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-string

# Database (PostgreSQL). Example for a local Postgres instance:
# postgresql://<user>:<password>@localhost:5432/coastsafe
DATABASE_URL=postgresql://coastsafe:coastsafe@localhost:5432/coastsafe

# JWT
JWT_SECRET_KEY=change-me-to-a-different-random-string
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# CORS - the deployed frontend origin(s), comma-separated
FRONTEND_ORIGINS=http://localhost:5173,https://coastsafe.vercel.app
